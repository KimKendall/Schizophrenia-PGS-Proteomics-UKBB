```{r any antipsychotic}
# Create the new variable 'any_antipsychotic' and initialise it
medications_proteomics1$any_antipsychotic <- NA

# Loop through each row to apply the logic
for (i in 1:nrow(medications_proteomics1)) {
  # Select the relevant columns for the current row
  relevant_columns <- medications_proteomics1[i, 20:52]

  # Check if all values in the relevant columns are NA
  if (all(is.na(relevant_columns))) {
    medications_proteomics1$any_antipsychotic[i] <- NA
  }
  # Check if any of the values in the relevant columns is 1
  else if (any(relevant_columns == 1, na.rm = TRUE)) {
    medications_proteomics1$any_antipsychotic[i] <- 1
  }
  # If none of the above, set to 0 (meaning no 1s and not all NAs)
  else {
    medications_proteomics1$any_antipsychotic[i] <- 0
  }
}

