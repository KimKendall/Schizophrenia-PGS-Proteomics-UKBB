# Create the new variable 'promazine_chlorpromazine'
medications_proteomics1$promazine_chlorpromazine <- NA

# Condition 1: If either column is 1, new column is 1
# Use pmax for row-wise maximum, which handles NA correctly for this logic
# If one is 1 and other is NA, pmax will return 1.
# If one is 0 and other is 1, pmax will return 1.
medications_proteomics1$promazine_chlorpromazine <- pmax(
  medications_proteomics1$chlorpromazine_present,
  medications_proteomics1$promazine_present,
  na.rm = FALSE # Keep NA if both are NA, otherwise pmax will return 0 if both are NA
)

medications_proteomics1$promazine_chlorpromazine <- apply(
  medications_proteomics1[, c("chlorpromazine_present", "promazine_present")],
  1, # Apply row-wise
  function(row_values) {
    cp <- row_values["chlorpromazine_present"]
    pp <- row_values["promazine_present"]

    if (is.na(cp) && is.na(pp)) {
      return(NA)
    } else if (!is.na(cp) && cp == 1 || !is.na(pp) && pp == 1) {
      return(1)
    } else if (!is.na(cp) && cp == 0 && !is.na(pp) && pp == 0) {
      return(0)
    } else {
      # This covers cases like (0, NA), (NA, 0), (1, NA), (NA, 1) etc.
      # The previous conditions handle (1, NA) and (NA, 1) to be 1.
      # So, remaining cases are (0, NA) or (NA, 0) which should result in NA based on your rule
      # "if there is a 1 in promazine_present or chlorpromazine_present - make the value in promazine_chlorpromazine equal 1.
      # if both columns are NA, make the value in the new column equal NA.
      # if there is a 0 in both promazine_present and chlorpromazine_present, make the value in the new column equal 0"
      # This implies if one is 0 and other is NA, the result should be NA.
      return(NA)
    }
  }
)

