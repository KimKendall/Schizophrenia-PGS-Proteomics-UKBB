# Function to create a new variable for a given antipsychotic
create_antipsychotic_variable <- function(data, ap_name) {
  # Generate a clean, valid column name for the new variable
  # Replaces non-alphanumeric characters with underscores and appends '_present'
  new_col_name <- tolower(ap_name) %>%
    str_replace_all("[^a-z0-9]", "_") %>% # Replace non-alphanumeric with _
    str_replace_all("__+", "_") %>%       # Replace multiple underscores with single
    str_replace_all("^_|_$", "") %>%      # Remove leading/trailing underscores
    paste0("_present")                    # Append '_present'

  # Use dplyr's rowwise() to apply the logic row by row
  data <- data %>%
    rowwise() %>% # This tells dplyr to perform operations row-by-row
    mutate(
      !!new_col_name := { # Create the new column with the generated name
        # Select columns 2 to 19 for the current row.
        # c_across() is used within rowwise() to select values from multiple columns.
        # Ensure your actual data frame has at least 19 columns.
        cols_to_check <- c_across(2:19)

        # Check if all selected columns for the current row are NA
        if (all(is.na(cols_to_check))) {
          NA_real_ # If all are NA, the new variable is NA (numeric type)
        } else {
          # Convert relevant columns to character and then to lowercase for case-insensitive matching
          # grepl() searches for the pattern (ap_name) in the text.
          # fixed = TRUE ensures an exact string match (no regular expressions).
          # na.rm = TRUE ensures that NA values in cols_to_check do not cause the any() function to return NA.
          any_match <- any(
            grepl(
              pattern = ap_name,
              x = tolower(as.character(cols_to_check)),
              fixed = TRUE
            ),
            na.rm = TRUE
          )
          # Assign 1 if a match is found, otherwise 0
          if (any_match) 1 else 0
        }
      }
    ) %>%
    ungroup() # Important: Always ungroup after using rowwise() to revert to normal data frame operations
  return(data)
}

