library(data.table)

kinship_threshold <- 0.0442

# rel_data and eu_analysis_file assumed already loaded

rel_dt <- as.data.table(rel_data)

analytic_ids <- unique(as.numeric(eu_analysis_file$eid_james))

pheno_dt <- as.data.table(eu_analysis_file)[, .(
  ID = as.numeric(eid_james),
  any_psychosis = any_psychosis
)]
pheno_dt[is.na(any_psychosis), any_psychosis := 0]

# 1. restrict to kinship > threshold and within-cohort pairs
remaining_pairs <- rel_dt[Kinship > kinship_threshold]

pairs_within_analytic <- remaining_pairs[
  ID1 %in% analytic_ids & ID2 %in% analytic_ids
]

# ensure numeric IDs
pairs_within_analytic[, `:=`(
  ID1 = as.numeric(ID1),
  ID2 = as.numeric(ID2)
)]

cat("Number of kinship >", kinship_threshold,
    "pairs with BOTH in proteomics cohort:", nrow(pairs_within_analytic), "\n")

# 2. SAFE GREEDY PRUNING LOOP WITH CHECKPOINTS
pairs_dt <- copy(pairs_within_analytic)
setkey(pairs_dt, ID1, ID2)

individuals_to_remove <- c()

checkpoint_file <- "individuals_to_remove_partial.txt"
backup_every <- 100

# resume if checkpoint exists
if (file.exists(checkpoint_file)) {
  message("Found existing checkpoint. Resuming...")
  individuals_to_remove <- scan(checkpoint_file, what = numeric())
  pairs_dt <- pairs_dt[!(ID1 %in% individuals_to_remove | ID2 %in% individuals_to_remove)]
}

iteration <- length(individuals_to_remove)

while (nrow(pairs_dt) > 0) {
  
  iteration <- iteration + 1
  
  # count occurrences
  id_counts <- melt(
    pairs_dt,
    measure.vars = c("ID1", "ID2"),
    value.name = "ID"
  )[, .N, by = ID]
  
  if (nrow(id_counts) == 0) break
  
  # make sure ID is numeric to match pheno_dt
  id_counts[, ID := as.numeric(ID)]
  
  # merge psychosis info
  id_counts <- merge(id_counts, pheno_dt, by = "ID", all.x = TRUE)
  id_counts[is.na(any_psychosis), any_psychosis := 0]
  id_counts[, is_case := as.integer(any_psychosis == 1)]
  
  # prefer to remove non-cases
  candidates <- id_counts[is_case == 0]
  if (nrow(candidates) == 0) {
    candidates <- id_counts  # only cases left
  }
  
  setorder(candidates, -N)
  id_to_remove <- candidates[1, ID]
  
  individuals_to_remove <- c(individuals_to_remove, id_to_remove)
  
  pairs_dt <- pairs_dt[ID1 != id_to_remove & ID2 != id_to_remove]
  
  if (iteration %% backup_every == 0) {
    writeLines(as.character(individuals_to_remove), checkpoint_file)
    message("Checkpoint written after ", iteration, " removals.")
  }
}

# final write
writeLines(as.character(individuals_to_remove), checkpoint_file)
message("Final checkpoint written to ", checkpoint_file)

# 3. inspect removals
removal_dt <- data.table(ID = individuals_to_remove)
removal_dt <- merge(removal_dt, pheno_dt, by = "ID", all.x = TRUE)

cat("Removal breakdown (0 = no psychosis, 1 = psychosis):\n")
print(table(removal_dt$any_psychosis, useNA = "ifany"))
